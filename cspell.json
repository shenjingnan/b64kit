{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "words": [
    "b64kit",
    "base64",
    "atob",
    "btoa",
    "vitest",
    "pnpm",
    "typecheck",
    "husky",
    "lintstaged",
    "nvmrc",
    "npmrc",
    "conventionalcommits",
    "dependabot",
    "shenjingnan",
    "oklch",
    "geist",
    "fontsource",
    "shadcn",
    "baseui",
    "luminance",
    "grayscale",
    "charaspect",
    "apos",
    "noopener"
  ],
  "ignoreRegExpList": ["data:image/[^']*"],
  "ignorePaths": [
    "node_modules",
    "dist",
    "coverage",
    "*.min.js",
    "*.min.d.ts",
    "pnpm-lock.yaml",
    ".git",
    "src/types"
  ],
  "enableFiletypes": true
}
